# Copy to apps/mobile/.env when the Expo app is added.
# The mobile app consumes these values; npm run check:firebase reads root .env.
EXPO_PUBLIC_API_MODE=firebase
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_API_KEY=fake
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-funswitch.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-funswitch
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-funswitch.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# localhost for iOS simulator; 10.0.2.2 for Android emulator;
# your computer's LAN IP for a physical phone.
EXPO_PUBLIC_EMULATOR_HOST=localhost

# For a real project, set USE_EMULATORS=false and copy your Firebase web app
# configuration above. Enable Email/Password authentication in Firebase.
# EXPO_PUBLIC_* values are included in the app. Never put service account keys here.

# Optional existing user for the read-only npm run check:firebase command.
# These are local CLI settings, not Expo public variables. Leave empty for
# an unauthenticated connectivity check. Do not commit populated .env files.
FIREBASE_CHECK_EMAIL=
FIREBASE_CHECK_PASSWORD=
